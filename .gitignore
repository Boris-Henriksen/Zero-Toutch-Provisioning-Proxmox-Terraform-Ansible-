# --- Python (backend) ---
**/__pycache__/
*.pyc
venv/

# --- Node (frontend) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.swp

# --- Runtime data & large binaries ---
# These are downloaded/generated by install.sh and scripts/prepare-discovery-image.sh
# and must not be committed to the repository.
storage/isos/*.iso
storage/isos/*/*.iso
storage/isos/*/.*.part
storage/discovery/source.txt
storage/extracted/*
storage/discovery/vmlinuz
storage/discovery/initrd
storage/discovery/ubuntu-live.iso
storage/tftpboot/ipxe.efi
storage/tftpboot/undionly.kpxe
storage/aborted-nodes.json

# Keep the empty runtime directories tracked in git
!storage/isos/.gitkeep
!storage/extracted/.gitkeep
!storage/discovery/.gitkeep
!storage/tftpboot/.gitkeep
